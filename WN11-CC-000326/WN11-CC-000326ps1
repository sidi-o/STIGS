#Requires -RunAsAdministrator

<#
.SYNOPSIS
    This PowerShell script ensures that PowerShell Script Block Logging is enabled on Windows 11 to record detailed command execution for security auditing.
    
.NOTES
    Author          : Sidi O
    LinkedIn        : linkedin.com/sidi-o
    GitHub          : github.com/sidi-o
    Date Created    : 2026-09-23
    Last Modified   : 2026-09-23
    Version         : 1.0
    CVEs            : N/A
    Plugin IDs      : N/A
    STIG-ID         : WN11-CC-000326

.TESTED ON
    Date(s) Tested  : 2026-09-23
    Tested By       : Sidi O
    Systems Tested  : Windows 11
    PowerShell Ver. : 5.1

.USAGE
    Example syntax:
    PS C:\> .\WN11-CC-000326.ps1
#>

# WN11-CC-000326
# PowerShell Script Block Logging must be enabled
#
# Registry:
# HKLM\SOFTWARE\Policies\Microsoft\Windows\PowerShell\ScriptBlockLogging
# EnableScriptBlockLogging = 1 (REG_DWORD)

$RegistryPath = 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\PowerShell\ScriptBlockLogging'
$ValueName    = 'EnableScriptBlockLogging'
$ExpectedValue = 1


# Create the policy key if it does not already exist
if (-not (Test-Path -LiteralPath $RegistryPath)) {
    New-Item -Path $RegistryPath -Force | Out-Null
}

# Configure Script Block Logging
New-ItemProperty -Path $RegistryPath -Name $ValueName -PropertyType DWord  -Value $ExpectedValue -Force | Out-Null

# Verify configuration
$configuredValue = Get-ItemPropertyValue  -Path $RegistryPath -Name $ValueName -ErrorAction Stop

if ($configuredValue -eq $ExpectedValue) {
    Write-Output 'PASS: PowerShell Script Block Logging is enabled.'
    Write-Output "Registry: $RegistryPath"
    Write-Output "$ValueName = $configuredValue (REG_DWORD)"
    exit 0
}
else {
    Write-Error "FAIL: $ValueName is configured as $configuredValue; expected $ExpectedValue."
    exit 1
}
